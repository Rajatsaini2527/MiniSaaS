# ── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:80

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://admin:secret@mongodb:27017/minisaas?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme_strong_password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redispass@redis:6379
REDIS_ENABLED=true
REDIS_PASSWORD=changeme_redis_password

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_REFRESH_SECRET=CHANGE_ME_different_min_32_chars_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Email / SMTP (optional) ───────────────────────────────────────────────────
# Leave empty to use console logging in development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM=noreply@minisaas.app

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ── Cloudinary (optional — for cloud file storage) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
