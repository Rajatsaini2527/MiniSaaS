{
  "name": "mini-saas-backend",
  "version": "1.0.0",
  "description": "Production-ready Mini SaaS backend inspired by Notion, Trello, and Slack",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/ tests/ --max-warnings 0",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^2.1.35",
    "mongoose": "8.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "3.13.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.5.0",
    "eslint": "9.5.0",
    "globals": "15.6.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.0.0",
    "nodemon": "3.1.4",
    "prettier": "3.3.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/setup.js",
    "globalTeardown": "./tests/teardown.js",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
